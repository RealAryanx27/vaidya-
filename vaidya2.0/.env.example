# AKESA AI Healthcare Assistant — Environment Configuration
# Copy this file to .env and configure your values

# Server Port (default: 3000)
PORT=3000

# Environment: development | production
NODE_ENV=development

# AI Provider: gemini | mock
AI_PROVIDER=gemini

# Google Gemini API Key
# Get a free key from Google AI Studio: https://aistudio.google.com/
# Leave empty to run with AKESA's built-in Lucknow Grounded Navigation Engine
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Specific Gemini Model (default: gemini-1.5-flash)
# Supported: gemini-1.5-flash, gemini-1.5-pro, gemini-2.0-flash-exp
GEMINI_MODEL=gemini-1.5-flash

# Hospital Region / City Focus
HEALTHCARE_REGION=Lucknow, Uttar Pradesh, India
